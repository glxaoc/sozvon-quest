# AiTunnel (LLM + batch STT). https://aitunnel.ru
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
LLM_MODEL=claude-haiku-4.5

# STT: nexara | yandex | aitunnel | mock
STT_PROVIDER=nexara

# Nexara (https://nexara.ru) — быстрый батч 0,36 ₽/мин, ключ nx-…
NEXARA_API_KEY=
NEXARA_BASE_URL=https://api.nexara.ru/v1
NEXARA_MODEL=nexara-ru
STT_MODEL=nova-3

# Yandex SpeechKit v3 streaming (API-ключ сервисного аккаунта с ролью ai.speechkit-stt.user)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

CONFIDENCE_THRESHOLD=0.8
CHECK_INTERVAL_MS=4000
