# Необязательно: всё это настраивается в мастере первого запуска и в настройках приложения.
# .env нужен только при запуске из исходников, если удобнее держать ключи в файле.

# Сверка: aitunnel (облако по ключу) | local (модель на компьютере, нужна видеокарта)
LLM_PROVIDER=aitunnel
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
LLM_MODEL=gemini-3.5-flash-lite

# Распознавание: local (на компьютере, бесплатно) | aitunnel | nexara | yandex | mock
STT_PROVIDER=local

# Nexara (https://nexara.ru), если STT_PROVIDER=nexara
NEXARA_API_KEY=

# Yandex SpeechKit v3, если STT_PROVIDER=yandex (адаптер экспериментальный)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Порог автозакрытия пункта
CONFIDENCE_THRESHOLD=0.8
