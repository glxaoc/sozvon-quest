{
  "name": "sozvon-quest",
  "version": "0.2.0",
  "description": "Созвон Квест — не даёт забыть, что важно обсудить на созвоне: список пунктов, живая отметка по ходу разговора, балл из 100 в конце",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:mock": "electron . --stt=mock",
    "shot": "electron . --screenshot=outputs/shot.png",
    "test:llm": "node test/test-llm.js",
    "test:stt": "node test/test-stt-chunked.js",
    "test:audio": "node test/test-audio-file.js",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "node-llama-cpp": "^3.21.1",
    "sherpa-onnx-node": "^1.13.8"
  },
  "productName": "SozvonQuest",
  "author": "Иван Дробитько <drobitkoivan@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/glxaoc/sozvon-quest",
  "build": {
    "appId": "pro.drobitko.sozvonquest",
    "productName": "SozvonQuest",
    "artifactName": "SozvonQuest-${version}-portable.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "proto/**",
      "package.json",
      "!**/*.map",
      "!node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/@node-llama-cpp/*-cuda*/**",
      "!node_modules/node-llama-cpp/llama/gitRelease.bundle",
      "!models/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/callquest.ico"
    },
    "portable": {
      "artifactName": "SozvonQuest-${version}-portable.exe"
    },
    "asar": true,
    "compression": "normal",
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/node-llama-cpp/**"
    ]
  }
}
